", "start": 6.963, "end": 7.525}, {"text": "A", "start": 8.145, "end": 8.232}, {"text": "K", "start": 8.232, "end": 8.495}, {"text": "V", "start": 8.495, "end": 8.682}, {"text": "cache", "start": 8.682, "end": 9.158}, {"text": "saves", "start": 9.158, "end": 9.495}, {"text": "past", "start": 9.495, "end": 9.832}, {"text": "key", "start": 9.832, "end": 10.145}, {"text": "and", "start": 10.145, "end": 10.27}, {"text": "value", "start": 10.27, "end": 10.62}, {"text": "vectors", "start": 10.62, "end": 11.07}, {"text": "in", "start": 11.07, "end": 11.232}, {"text": "G", "start": 11.232, "end": 11.42}, {"text": "P", "start": 11.42, "end": 11.62}, {"text": "U", "start": 11.62, "end": 11.77}, {"text": "memory", "start": 11.77, "end": 12.42}, {"text": "slashing", "start": 12.558, "end": 13.045}, {"text": "compute", "start": 13.045, "end": 13.545}, {"text": "from", "start": 13.545, "end": 13.695}, {"text": "quadratic", "start": 13.695, "end": 14.27}, {"text": "to", "start": 14.27, "end": 14.395}, {"text": "linear", "start": 14.395, "end": 15.07}]}, {"wav": "kvcache-1-451a80d608e2.wav", "say": "Yet a hidden wall hits immediately. To emit one token, the GPU must stream hundreds of gigabytes of weights and cached history over HBM bandwidth. With arithmetic intensity stuck near one, giant chips sit ninety-nine percent idle waiting on memory.", "text": "Yet a hidden wall hits immediately. To emit one token, the G P U must stream hundreds of gigabytes of weights and cached history over H B M bandwidth. With arithmetic intensity stuck near one, giant chips sit ninety-nine percent idle waiting on memory.", "duration": 16.665, "hold": 0.4, "words": [{"text": "Yet", "start": 0.25, "end": 0.388}, {"text": "a", "start": 0.388, "end": 0.45}, {"text": "hidden", "start": 0.45, "end": 0.725}, {"text": "wall", "start": 0.725, "end": 1.025}, {"text": "hits", "start": 1.025, "end": 1.288}, {"text": "immediately", "start": 1.288, "end": 2.125}, {"text": "To", "start": 2.77, "end": 2.895}, {"text