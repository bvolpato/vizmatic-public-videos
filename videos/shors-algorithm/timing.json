{"voice": "af_heart", "speed": 1.12, "intro": 0.7, "lead": 1.0499999999999998, "gap": 0.55, "tail": 1.4, "fingerprint": "0ea7da62fa52a1c3", "scenes": [{"id": "hook", "title": "Wave interference, not parallel guessing", "beats": [{"wav": "hook-0-48ab13d9f063.wav", "say": "Forget the hype that quantum computers simply try every answer in parallel. If you measure a flat superposition, you just pull out random noise. The real trick is complex wave interference. Wrong answers rotate out of phase and cancel to black, while the hidden answer aligns into a blazing peak.", "text": "Forget the hype that quantum computers simply try every answer in parallel. If you measure a flat superposition, you just pull out random noise. The real trick is complex wave interference. Wrong answers rotate out of phase and cancel to black, while the hidden answer aligns into a blazing peak.", "duration": 18.56, "hold": 0.35, "words": [{"text": "Forget", "start": 0.225, "end": 0.512}, {"text": "the", "start": 0.512, "end": 0.6}, {"text": "hype", "start": 0.6, "end": 0.875}, {"text": "that", "start": 0.875, "end": 1.025}, {"text": "quantum", "start": 1.025, "end": 1.4}, {"text": "computers", "start": 1.4, "end": 2.112}, {"text": "simply", "start": 2.112, "end": 2.45}, {"text": "try", "start": 2.45, "end": 2.812}, {"text": "every", "start": 2.812, "end": 3.125}, {"text": "answer", "start": 3.125, "end": 3.5}, {"text": "in", "start": 3.5, "end": 3.6}, {"text": "parallel", "start": 3.6, "end": 4.35}, {"text": "If", "start": 4.97, "end": 5.12}, {"text": "you", "start": 5.12, "end": 5.245}, {"text": "measure", "start": 5.245, "end": 5.57}, {"text": "a", "start": 5.57, "end": 5.657}, {"text": "flat", "start": 5.657, "end": 5.945}, {"text": "superposition", "start": 5.945, "end": 6.795}, {"text": "you", "start": 6.895, "end": 6.995}, {"text": "just", "start": 6.995, "end": 7.17}, {"text": "pull", "start": 7.17, "end": 7.357}, {"text": "out", "start": 7.357, "end": 7.57}, {"text": "random", "start": 7.