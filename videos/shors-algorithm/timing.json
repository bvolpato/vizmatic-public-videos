 the equator in an equal superposition of zero and one.", "duration": 17.065, "hold": 0.35, "words": [{"text": "A", "start": 0.225, "end": 0.3}, {"text": "classical", "start": 0.3, "end": 0.775}, {"text": "bit", "start": 0.775, "end": 1.0}, {"text": "sits", "start": 1.0, "end": 1.188}, {"text": "at", "start": 1.188, "end": 1.275}, {"text": "zero", "start": 1.275, "end": 1.663}, {"text": "or", "start": 1.663, "end": 1.825}, {"text": "one", "start": 1.825, "end": 2.35}, {"text": "A", "start": 2.995, "end": 3.083}, {"text": "cue", "start": 3.083, "end": 3.32}, {"text": "bit", "start": 3.32, "end": 3.558}, {"text": "lives", "start": 3.558, "end": 3.883}, {"text": "anywhere", "start": 3.883, "end": 4.332}, {"text": "on", "start": 4.332, "end": 4.433}, {"text": "the", "start": 4.433, "end": 4.52}, {"text": "Block", "start": 4.52, "end": 4.82}, {"text": "sphere", "start": 4.82, "end": 5.345}, {"text": "described", "start": 5.47, "end": 5.945}, {"text": "by", "start": 5.945, "end": 6.133}, {"text": "complex", "start": 6.133, "end": 6.695}, {"text": "amplitudes", "start": 6.695, "end": 7.52}, {"text": "whose", "start": 7.52, "end": 7.707}, {"text": "squared", "start": 7.707, "end": 8.095}, {"text": "lengths", "start": 8.095, "end": 8.47}, {"text": "give", "start": 8.47, "end": 8.695}, {"text": "measurement", "start": 8.695, "end": 9.12}, {"text": "probabilities", "start": 9.12, "end": 10.095}, {"text": "Apply", "start": 10.715, "end": 11.015}, {"text": "a", "start": 11.015, "end": 11.127}, {"text": "Hah", "start": 11.127, "end": 11.39}, {"text": "dah", "start": 11.39, "end": 11.615}, {"text": "mard", "start": 11.615, "end": 11.89}, {"text": "gate", "start": 11.89, "end": 12.465}, {"text": "and", "start": 12.565, "end": 12.678}, {"text": "the", "start": 12.678, "end": 12.765}, {"text": "state", "start": 12.765, "end": 13.102}, {"text": "swings", "start": 13.102, "end": 13.44}, {"text": "onto", "start": 13.44, "end": 13.678}, {"text": "the", "start": 13.678, "end": 13.765}, {"