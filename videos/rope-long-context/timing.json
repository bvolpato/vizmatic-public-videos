end": 9.09}, {"text": "language", "start": 9.09, "end": 9.465}, {"text": "models", "start": 9.465, "end": 10.127}, {"text": "solve", "start": 10.127, "end": 10.49}, {"text": "this", "start": 10.49, "end": 10.74}, {"text": "with", "start": 10.74, "end": 10.928}, {"text": "Rotary", "start": 10.928, "end": 11.39}, {"text": "Positional", "start": 11.39, "end": 11.877}, {"text": "Embeddings", "start": 11.877, "end": 12.69}, {"text": "spinning", "start": 12.803, "end": 13.115}, {"text": "a", "start": 13.115, "end": 13.227}, {"text": "galaxy", "start": 13.227, "end": 13.765}, {"text": "of", "start": 13.765, "end": 13.865}, {"text": "hidden", "start": 13.865, "end": 14.14}, {"text": "clocks", "start": 14.14, "end": 14.627}, {"text": "inside", "start": 14.627, "end": 15.178}, {"text": "every", "start": 15.178, "end": 15.49}, {"text": "token", "start": 15.49, "end": 16.19}]}]}, {"id": "clocks", "title": "Exact 2D complex rotation geometry", "beats": [{"wav": "clocks-0-b73c04d5bf2c.wav", "say": "Early models simply added a position vector to every word, muddying meaning and distance together. RoPE does something far cleaner. It pairs up every two dimensions into a tiny two-dimensional compass needle, and rotates that needle by an angle proportional to token position m.", "text": "Early models simply added a position vector to every word, muddying meaning and distance together. rope does something far cleaner. It pairs up every two dimensions into a tiny two-dimensional compass needle, and rotates that needle by an angle proportional to token position m.", "duration": 17.865, "hold": 0.35, "words": [{"text": "Early", "start": 0.25, "end": 0.55}, {"text": "models", "start": 0.55, "end": 1.075}, {"text": "simply", "start": 1.075, "end": 1.438}, {"text": "added", "start": 1.438, "end": 1.688}, {"text": "a", "start": 1.688, "end": 1.75}, {"text": "position", "start": 1.75, "end": 2.225}, {"text": "vector", "start": 2.225, "end": 2.837}, {"text": "to", "start": 2.837, "end": 3.013}, {"text": "every", "start": 3.013, "end": 3.325}, {"text": "word", "start": 3.325, "end": 3.85}, {"text": "muddying", "start": 3.962, "end": 4.4}, {"text": "meaning", "start": 4.4, "end": 4.8}, {"text": "and", "start": 4.8, "end": 4.925}, {"text": "distance", "start": 4.925, "end": 5.325}, {"text": "together", "start": 5.325, "end": 5.975}, {"text": "rope", "start": 6.67, "end": 6.945}, {"text": "does", "start": 6.945, "end": 7.095}, {"text": "something", "start": 7.095, "end": 7.407}, {"text": "far", "start": 7.407, "end": 7.67}, {"text": "cleaner", "start": 7.67, "end": 8.27}, {"text": "It", "start": 8.89, "end": 9.015}, {"text": "pairs", "start": 9.015, "end": 9.303}, {"text": "up", "start": 9.303, "end": 9.502}, {"text": "every", "start": 9.502, "end": 9.827}, {"text": "two", "start": 9.827, "end": 10.04}, {"text": "dimensions", "start": 10.04, "end": 10.74}, {"text": "into", "start": 10.74, "end": 10.99}, {"text": "a", "start": 10.99, "end": 11.102}, {"text": "tiny", "start": 11.102, "end": 11.552}, {"text": "two-dimensional", "start": 11.552, "end": 12.29}, {"text": "compass", "start": 12.29, "end": 12.64}, {"text": "needle", "start": 12.64, "end": 13.29}, {"text": "and", "start": 13.39, "end": 13.515}, {"text": "rotates", "start": 13.515, "end": 14.04}, {"text": "that", "start": 14.04, "end": 14.24}, {"text": "needle", "start": 14.24, "end": 14.752}, {"text": "by", "start": 14.752, "end": 14.927}, {"text": "an", "start": 14.927, "end": 15.052}, {"text": "angle", "start": 15.052, "end": 15.44}, {"text": "proportional", "start": 15.44, "end": 16.115}, {"text": "to", "start": 16.115, "end": 16.215}, {"text": "token", "start": 16.215, "end": 16.565}, {"text": "position", "start": 16.565, "end": 17.053}, {"text": "m.", "start": 17.053, "end": 17.665}]}, {"wav": "clocks-1-41b2b62b75bc.wav", "say": "Now watch the geometric magic when a query at position m attends to a key at position n. Because rotation preserves lengths and angles, their dot product depends solely on the angle difference between them: m minus n times theta. Absolute positions vanish, leaving pure relative distance.", "text": "Now watch the geometric magic when a query at position m attends to a key at position n. Because rotation preserves lengths and angles, their dot product depends solely on the angle difference between them: m minus n times thay tah. Absolute positions vanish, leaving pure relative distance.", "duration": 19.09, "hold": 0.4, "words": [{"text": "Now", "start": 0.275, "end": 0.5}, {"text": "watch", "start": 0.5, "end": 0.8}, {"text": "the", "start": 0.8, "end": 0.9}, {"text": "geometric", "start": 0.9, "end": 1.425}, {"text": "magic", "start": 1.425, "end": 2.062}, {"text": "when", "start": 2.062, "end": 2.212}, {"text": "a", "start": 2.212, "end": 2.275}, {"text": "query", "start": 2.275, "end": 2.612}, {"text": "at", "start": 2.612, "end": 2.7}, {"text": "position", "start": 2.7, "end": 3.188}, {"text": "m", "start": 3.188, "end": 3.7}, {"text": "attends", "start": 3.7, "end": 4.1}, {"text": "to", "start": 4.1, "end": 4.188}, {"text": "a", "start": 4.188, "end": 4.287}, {"text": "key", "start": 4.287, "end": 4.55}, {"text": "at", "start": 4.55, "end": 4.65}, {"text": "position", "start": 4.65, "end": 5.125}, {"text": "n.", "start": 5.125, "end": 5.65}, {"text": "Because", "start": 6.245, "end": 6.545}, {"text": "rotation", "start": 6.545, "end": 7.12}, {"text": "preserves", "start": 7.12, "end": 7.657}, {"text": "lengths", "start": 7.657, "end": 8.02}, {"text": "and", "start": 8.02, "end": 8.145}, {"text": "angles", "start": 8.145, "end": 8.845}, {"text": "their", "start": 8.92, "end": 9.095}, {"text": "dot", "start": 9.095, "end": 9.345}, {"text": "product", "start": 9.345, "end": 9.795}, {"text": "depends", "start": 9.795, "end": 10.22}, {"text": "solely", "start": 10.22, "end": 10.683}, {"text": "on", "start": 10.683, "end": 10.782}, {"text": "the", "start": 10.782, "end": 10.907}, {"text": "angle", "start": 10.907, "end": 11.245}, {"text": "difference", "start": 11.245, "end": 11.62}, {"text": "between", "start": 11.62, "end": 11.933}, {"text": "them", "start": 11.933, "end": 12.495}, {"text": "m", "start": 12.633, "end": 12.845}, {"text": "minus", "start": 12.845, "end": 13.383}, {"text": "n", "start": 13.383, "end": 13.595}, {"text": "times", "start": 13.595, "end": 13.97}, {"text": "thay", "start": 13.97, "end": 14.17}, {"text": "tah", "start": 14.17, "end": 14.695}, {"text": "Absolute", "start": 15.39, "end": 15.84}, {"text": "positions", "start": 15.84, "end": 16.39}, {"text": "vanish", "start": 16.39, "end": 16.99}, {"text": "leaving", "start": 17.09, "end": 17.428}, {"text": "pure", "start": 17.428, "end": 17.74}, {"text": "relative", "start": 17.74, "end": 18.165}, {"text": "distance", "start": 18.165, "end": 18.865}]}]}, {"id": "helix3d", "title": "3D helical ribbons and attention decay", "beats": [{"wav": "helix3d-0-4f5825760c48.wav", "say": "One single clock wraps around too fast to tell position ten from position five hundred. So RoPE runs dozens of clocks at once across the embedding dimensions, with frequencies spaced geometrically from rapid local ticks down to glacially slow sweeps.", "text": "One single clock wraps around too fast to tell position ten from position five hundred. So rope runs dozens of clocks at once across the embedding dimensions, with frequencies spaced geometrically from rapid local ticks down to glacially slow sweeps.", "duration": 15.97, "hold": 0.35, "words": [{"text": "One", "start": 0.25, "end": 0.487}, {"text": "single", "start": 0.487, "end": 0.825}, {"text": "clock", "start": 0.825, "end": 1.212}, {"text": "wraps", "start": 1.212, "end": 1.55}, {"text": "around", "start": 1.55, "end": 1.887}, {"text": "too", "start": 1.887, "end": 2.1}, {"text": "fast", "start": 2.1, "end": 2.638}, {"text": "to", "start": 2.638, "end": 2.75}, {"text": "tell", "start": 2.75, "end": 3.0}, {"text": "position", "start": 3.0, "end": 3.462}, {"text": "ten", "start": 3.462, 