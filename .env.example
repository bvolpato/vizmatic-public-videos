# Voice provider: "kokoro" (default, free & local) or "elevenlabs" (opt-in studio voices)
VIZMATIC_VOICE_PROVIDER=kokoro

# Optional ElevenLabs settings (only used when VIZMATIC_VOICE_PROVIDER=elevenlabs)
# You can either paste your API key here or store it at ~/.config/fido/elevenlabs_api_key (chmod 600).
# ELEVENLABS_API_KEY=sk_...
# Named presets: bella | sarah | alice | matilda | jessica | lily (or pass any ElevenLabs voice_id)
ELEVENLABS_VOICE=bella
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_SPEED=1.10

# Render tuning (defaults auto-detect CPU/GPU and parallel workers)
# VIZMATIC_BACKEND=auto
# VIZMATIC_ENCODER=auto
# VIZMATIC_WORKERS=6
